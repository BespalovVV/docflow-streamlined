# ==============================================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ DOCFLOW STREAMLINED (.env.example)
# Скопируйте в .env и заполните уникальными секретами перед запуском в production.
# ==============================================================================

# --- Основные настройки приложения ---
PORT=3000
NODE_ENV=production
# Секрет подписи JWT-сессий DocFlow (сгенерируйте случайную строку >= 32 символов)
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_JWT_SECRET_MIN_32_CHARS

# --- База данных PostgreSQL + pgvector ---
PGHOST=postgres
PGPORT=5432
PGUSER=docflow
PGPASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
PGDATABASE=docflow_db

# --- Облачное хранилище MinIO S3 ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=docflow_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET=docflow-storage

# --- Редактор документов ONLYOFFICE Docs ---
# Публичный адрес ONLYOFFICE (или путь через Nginx, например https://docflow.example.ru/onlyoffice)
ONLYOFFICE_PUBLIC_URL=https://docflow.example.ru/onlyoffice

# --- Локальные модели эмбеддингов / RAG ---
HF_CACHE_DIR=/app/.hf_cache
EMBEDDING_MODEL=Xenova/multilingual-e5-small

# ==============================================================================
# ДВУСТОРОННЕЕ SSO С LABSPACE (Authorization Code + Back-Channel Exchange)
# Если поля не заполнены — маршруты /api/sso/* отключены (404 / enabled: false).
# ==============================================================================

# 1. Фиксированный HTTPS origin LabSpace без пути (должен совпадать с доменом LabSpace)
SSO_LABSPACE_URL=https://labspace.example.ru

# 2. Опциональный внутренний URL для сервер-сервер обмена кодов (Docker-сеть / localhost).
# Если пусто — используется SSO_LABSPACE_URL.
# SSO_LABSPACE_INTERNAL_URL=http://host.docker.internal:8100

# 3. Два ОТДЕЛЬНЫХ случайных URL-safe секрета (32-256 символов [A-Za-z0-9_-]):
#    Сгенерировать в Python: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#    Сгенерировать в Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
#    Соответствие в LabSpace:
#    SSO_LABSPACE_CLIENT_SECRET -> LABSPACE_SSO_LABSPACE_CLIENT_SECRET в LabSpace
#    SSO_DOCFLOW_CLIENT_SECRET  -> LABSPACE_SSO_DOCFLOW_CLIENT_SECRET  в LabSpace
SSO_LABSPACE_CLIENT_SECRET=
SSO_DOCFLOW_CLIENT_SECRET=

# Только для отладки без HTTPS на локальном стенде (в production не указывать / 0):
# SSO_ALLOW_HTTP=0
